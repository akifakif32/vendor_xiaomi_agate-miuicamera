// Copy of the Lineage libutils-v32 prebuilt without the CallStack hooks. The stock MiAlgo
// engine destroys hundreds of RefBase objects on every camera mode switch, each of them
// would print a 60 frame backtrace and the mode switch takes 5 seconds.
cc_prebuilt_library_shared {
    name: "libutils-v32-nocs",
    owner: "xiaomi",
    strip: {
        none: true,
    },
    shared_libs: [
        "libc++",
        "libcutils",
        "liblog",
        "libprocessgroup",
        "libprocessgroup_shim",
        "libvndksupport",
    ],
    target: {
        android_arm64: {
            srcs: ["proprietary/vendor/lib64/libutils-v32-nocs.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    soc_specific: true,
}

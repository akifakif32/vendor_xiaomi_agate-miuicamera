soong_namespace {
}

android_app_import {
    name: "MiuiCamera",
    owner: "xiaomi",
    apk: "proprietary/product/priv-app/MiuiCamera/MiuiCamera.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    enforce_uses_libs: false,
    overrides: [
        "Camera2",
        "Snap",
    ],
    privileged: true,
    product_specific: true,
}

cc_prebuilt_library_shared {
    name: "libcamera_algoup_jni.xiaomi",
    owner: "xiaomi",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["proprietary/system/lib64/libcamera_algoup_jni.xiaomi.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    prefer: true,
}


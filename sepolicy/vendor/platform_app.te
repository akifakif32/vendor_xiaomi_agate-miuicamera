# MiuiCamera uses the ISP HAL, same as stock: hal_mtk_bgs client and binder into the camera HAL.
# The app targets SDK <= 36 so it runs as platform_app_36, not platform_app.
hal_client_domain(platform_app, hal_mtk_bgs)
hal_client_domain(platform_app_36, hal_mtk_bgs)
binder_call(platform_app, mtk_hal_camera)
binder_call(platform_app_36, mtk_hal_camera)

# Same access stock gives the camera app for the AI plugins (APU, MDLA, VPU) and the MTK camera
allow platform_app apusys_device:chr_file { ioctl read write open getattr };
allow platform_app mdla_device:chr_file { ioctl read write getattr lock append map open };
allow platform_app vpu_device:chr_file { ioctl read write getattr lock append map open };
allow platform_app proc_mtk_jpeg:file { ioctl read write getattr lock append map open };
allow platform_app debugfs_ion:dir search;
get_prop(platform_app, vendor_mtkcam_prop)
binder_call(platform_app, mtk_hal_neuralnetworks)
allow platform_app vendor_camera_data_file:dir { ioctl read write create getattr setattr lock rename open add_name remove_name search rmdir };
allow platform_app vendor_camera_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open };
allow platform_app_36 apusys_device:chr_file { ioctl read write open getattr };
allow platform_app_36 mdla_device:chr_file { ioctl read write getattr lock append map open };
allow platform_app_36 vpu_device:chr_file { ioctl read write getattr lock append map open };
allow platform_app_36 proc_mtk_jpeg:file { ioctl read write getattr lock append map open };
allow platform_app_36 debugfs_ion:dir search;
get_prop(platform_app_36, vendor_mtkcam_prop)
binder_call(platform_app_36, mtk_hal_neuralnetworks)
allow platform_app_36 vendor_camera_data_file:dir { ioctl read write create getattr setattr lock rename open add_name remove_name search rmdir };
allow platform_app_36 vendor_camera_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open };
